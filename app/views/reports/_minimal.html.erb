<%# locals: (monitor:, reports:) %>

<%- filler_reports = 90 - reports.size %>

<section class="flex" id=<%= dom_id(monitor, :minimal_history) %> >
  <% filler_reports.times do %>
    <%= render "reports/minimal_report", report: nil %>
  <% end %> 

  <% reports.each do |report| %>
    <%= render "reports/minimal_report", report: report %>
  <% end %>
</section>

