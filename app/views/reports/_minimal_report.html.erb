<%# locals: (report: nil, is_new: false) %>
<%- path = report ? report_path(report.id) : "#" %>
<%= link_to path, class: class_names("report w-3 h-8 hover:h-12 dropdown dropdown-hover border-2 border-white transition-all", report_color(report), "is-new": is_new) do %>
  <% if report %>
    <%= turbo_frame_tag dom_id(report), src: url_for(report), loading: :lazy, class: "dropdown-content menu bg-primary-contennt top-10 rounded-box z-1 w-52 p-2 shadow-sm" do %>
      <span class="loading loading-spinner loading-md"></span>
    <% end %>
  <% else %>
    <div class="dropdown-content menu bg-primary-contennt top-10 rounded-box z-1 w-52 p-2 shadow-sm">
      <p>No data :\</p>
    </div>
    
  <% end %>
<% end %>

