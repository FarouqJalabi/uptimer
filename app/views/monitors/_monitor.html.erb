<%= turbo_stream_from monitor %>

<%= turbo_frame_tag dom_id(monitor) do %>
  <section class="py-2 h-[90px]"> <!-- h 90 so it matches form  -->
    <h3 class="text-md"> <%= monitor.name %> </h3>
    <div class="flex items-center gap-2"> 
      <%= render "reports/minimal", monitor: monitor, reports: monitor.reports.select(:id, :up) %>

      <div class="flex gap-2 ">
        <%= link_to "Edit", url_for([:edit, monitor]), class: "btn" %>
        <%= button_to "Destroy", monitor, method: :delete, class: "btn btn-error", data: { turbo_confirm: "Are you sure?" } %>
      </div>
    </div>
  </section>
<% end %>
