<% content_for :title, "Monitors" %>

<div class="w-full">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Heartbeat monitors</h1>
  </div>
  <p>
    We wait for website to send us post request to /api/monitor_heartbeat, if "time_considered_active" is passed we update false.
    <div class="mockup-code">
      <pre data-prefix="$"><code>curl -X POST https://uptimer.rubynor.com/api/monitor_heartbeat \
      -H "Content-Type: application/json" \
      -H "Secret: your_secret" \
      -d '{"cpu": "67%", "ram": "67%"}'</code>
    </pre>
    </div>
    
  </p>

  <div id="monitor_heartbeats" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @monitor_heartbeats.any? %>
      <%= render partial: "monitors/monitor", collection: @monitor_heartbeats, as: :monitor %>
    <% else %>
      <p class="text-center my-10">No heartbeats found.</p>
    <% end %>

    <%= turbo_frame_tag "new_monitor_heartbeat" do %>
      <%= link_to "New heartbeat monitor", new_monitor_heartbeat_path, class: "btn btn-primary" %>
    <% end %>
  </div>

  <div class="flex justify-between items-center mt-10">
    <h1 class="font-bold text-4xl">Fetch monitors</h1>
  </div>
  <p>
    We activly send "get" request for website and store any errors
  </p>

  <div id="monitor_fetches" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @monitor_fetches.any? %>
      <%= render partial: "monitors/monitor", collection: @monitor_fetches, as: :monitor %>
    <% else %>
      <p class="text-center my-10">No fetches found.</p>
    <% end %>

    <%= turbo_frame_tag "new_monitor_fetch" do %>
      <%= link_to "New fetch monitor", new_monitor_fetch_path, class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
