<%= form_with(model: monitor_heartbeat, class: "fieldset bg-base-200 border-base-300 rounded-box w-xs border p-4") do |form| %>
  <%= form.label :name %>
  <%= form.text_field :name, class: "input "%>
  <%= form.label :time_considered_active %>
  <%= form.number_field :time_considered_active, class: "input", min: 0 %>
  <%= form.submit class: "btn btn-primary mt-4", value: "Create Heartbeat monitor" %>
<% end %>
