<%= form_with(model: monitor_heartbeat, class: "fieldset bg-primary-content border-base-300 rounded-box border p-4 sm:h-[90px] inline-flex sm:flex-row flex-col items-center gap-4") do |form| %>
  <div class="not-has-[p]:mb-4">
    <%= form.label :name %>
    <%= form.text_field :name, class: "input "%>
  </div>

  <div class="not-has-[p]:mb-4">
    <%= form.label :time_considered_active %>
    <%= form.number_field :time_considered_active, class: "input", min: 0 %>
  </div>

  <% if monitor_heartbeat.persisted? %>
    <button type="button" onclick="navigator.clipboard.writeText('<%= monitor_heartbeat.secret %>')" class="btn">Copy secret</button>
  <% end %>


  <%= form.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", monitors_path %>
<% end %>
