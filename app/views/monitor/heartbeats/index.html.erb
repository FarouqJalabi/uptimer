<% content_for :title, "Heartbeats" %>

<div class="w-full">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Heartbeats</h1>
    <%= link_to "New heartbeat", new_monitor_heartbeat_path, class: "btn btn-primary" %>
  </div>
  <p>
    We wait for website to send us post request to /api/monitor_heartbeat, if "time_considered_active" is passed we update false.
  </p>



  <div id="monitor_heartbeats" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @monitor_heartbeats.any? %>
      <% @monitor_heartbeats.each do |monitor_heartbeat| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%= render monitor_heartbeat %>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
            <%= link_to "Show", monitor_heartbeat, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
            <%= link_to "Edit", edit_monitor_heartbeat_path(monitor_heartbeat), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
            <%= button_to "Destroy", monitor_heartbeat, method: :delete, class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No heartbeats found.</p>
    <% end %>
  </div>
</div>
