<% content_for :title, "Showing heartbeat" %>

<div class="flex flex-col gap-4">
  <div class="md:w-2/3 w-full">
    <h1 class="font-bold text-4xl">Showing heartbeat monitor</h1> 

    <%= render "monitors/monitor", monitor: @monitor_heartbeat %>

    <%= link_to "Back to monitors", monitors_path, class: "btn" %>
    <%= button_to "Destroy", @monitor_heartbeat, method: :delete, class: "btn btn-error", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>
