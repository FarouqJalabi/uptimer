<% content_for :title, "Showing heartbeat" %>

<div class="flex flex-col gap-4">
  <div class="md:w-2/3 w-full">
    <h1 class="font-bold text-4xl">Showing heartbeat</h1>

    <div class="mockup-code w-full">
      <pre data-prefix="$"><code>curl -X POST https://uptimer.rubynor.com/api/monitor_heartbeat  -H "Content-Type: application/json" -d "{\"id\": <%= @monitor_heartbeat.id %>, \"cpu\": \"67%\", \"ram\": \"67%\"}"</code></pre>
    </div>

    
    <%= render @monitor_heartbeat %>

    <%= link_to "Edit this heartbeat", edit_monitor_heartbeat_path(@monitor_heartbeat), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
    <%= link_to "Back to heartbeats", monitor_heartbeats_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
    <%= button_to "Destroy this heartbeat", @monitor_heartbeat, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "w-full rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>

    <div id="last_report">
      <% if @monitor_heartbeat.reports.any? %>
        <%= render "reports/report", report: @monitor_heartbeat.reports.last %>
      <% end %>
    </div>

  </div>
</div>
