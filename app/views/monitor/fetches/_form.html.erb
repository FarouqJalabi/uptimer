<%= form_with(model: monitor_fetch, class: "fieldset bg-primary-content border-base-300 rounded-box border p-6 flex sm:flex-row flex-col items-center gap-4 w-full") do |form| %>
  <%= form.label :name %>
  <%= form.text_field :name, class: "input "%>

  <%= form.label :url %>
  <%= form.url_field :url, class: "input" %>

  <%= form.label :poll_interval %>
  <%= form.number_field :poll_interval, class: "input", min: 0 %>

  <%= form.submit class: "btn btn-primary", value: "Create Fetch monitor" %>
  <% if monitor_fetch.persisted? %>
    <%= link_to "Cancel", monitor_fetch %>
  <% else %>
    <%= link_to "Cancel", monitors_path, data: { turbo_frame: "_top", turbo_action: "advance" } %>
  <% end %>
<% end %>

