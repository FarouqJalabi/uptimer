<%= form_with(model: monitor_fetch, class: "fieldset bg-primary-content border-base-300 rounded-box border p-4 sm:h-[90px] inline-flex sm:flex-row flex-col items-center gap-4") do |form| %>
  <div class="not-has-[p]:mb-4">
    <%= form.label :name %>
    <%= form.text_field :name, class: "input "%>
  </div>

  <div  class="not-has-[p]:mb-4">
    <%= form.label :url %>
    <%= form.url_field :url, class: "input" %>
  </div>

  <div class="not-has-[p]:mb-4">
    <%= form.label :poll_interval %>
    <%= form.number_field :poll_interval, class: "input", min: 0 %>
  </div>

  <%= form.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", monitors_path %>
<% end %>

