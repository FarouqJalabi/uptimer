<%= form_with(model: monitor_fetch, class: "fieldset bg-base-200 border-base-300 rounded-box w-xs border p-4") do |form| %>
  <%= form.label :name %>
  <%= form.text_field :name, class: "input "%>

  <%= form.label :url %>
  <%= form.url_field :url, class: "input" %>

  <%= form.label :poll_interval %>
  <%= form.number_field :poll_interval, class: "input", min: 0 %>
  <%= form.submit class: "btn btn-primary mt-4", value: "Create Fetch monitor" %>
<% end %>
