<%= form_with(model: monitor_fetch, class: "fieldset bg-primary-content border-base-300 rounded-box border p-4 sm:h-[90px] inline-flex sm:flex-row flex-col items-center gap-4", data: { turbo_frame: monitor_fetch.persisted? ? "" : "_top" }) do |form| %>
  <div class="not-has-[p]:mb-4">
    <%= form.label :name %>
    <%= form.text_field :name, class: "input "%>
  </div>

  <div  class="not-has-[p]:mb-4">
    <%= form.label :url %>
    <%= form.url_field :url, class: "input" %>
  </div>

  <div class="not-has-[p]:mb-4">
    <%= form.label :poll_interval %>
    <%= form.number_field :poll_interval, class: "input", min: 0 %>
  </div>

  <%= form.submit class: "btn btn-primary" %>
  <% if monitor_fetch.persisted? %>
    <%= link_to "Cancel", monitor_fetch %>
  <% else %>
    <%= link_to "Cancel", monitors_path, data: { turbo_frame: "_top", turbo_action: "advance" } %>
  <% end %>
<% end %>

