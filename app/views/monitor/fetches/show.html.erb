<% content_for :title, "Showing fetch" %>

<div class="flex flex-col gap-4">
  <div class="md:w-2/3 w-full">
    <h1 class="font-bold text-4xl">Showing fetch monitor</h1>

    <%= render "monitors/monitor", monitor: @monitor_fetch %>

    <%= link_to "Back to monitors", monitors_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
    <%= button_to "Destroy", @monitor_fetch, method: :delete, class: "btn btn-error", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>
