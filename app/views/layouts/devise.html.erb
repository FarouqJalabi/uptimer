<%= content_for(:content) do %>
  <div class="hero bg-base-200 min-h-screen">
    <div class="hero-content flex-col lg:flex-row-reverse">
      <div class="text-center lg:text-left">
        <div class="flex items-center ">
          <h1 class="text-5xl font-bold">Uptimer</h1>
          <%= image_tag "/icon.svg", class: "w-15" %>
        </div>
        <p class="py-6 max-w-xl">
          Uptimer overvåker nettsidene dine i sanntid, varsler deg når noe går galt, og gir deg full historikk over ytelse og tilgjengelighet – alt på ett sted.
        </p>
      </div>
      <%= yield %>
    </div>
  </div>
<% end %>

<%= render template: "layouts/application" %>
